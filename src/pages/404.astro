---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Halaman tidak ditemukan — Sky" description="Halaman ini belum ditemukan. Mari kembali ke langit." activePage="404" route="404.html">
  <section class="not-found" aria-labelledby="page-title">
    <p class="eyebrow" data-reveal>SEPERTINYA KITA TERBANG TERLALU JAUH</p>
    <p class="not-found__number" aria-hidden="true">404</p>
    <h1 id="page-title" class="display-title" data-reveal>Jalan ini belum<br /><em>menemukan langit.</em></h1>
    <p data-reveal>Mungkin cahaya di sini sudah padam. Kita bisa kembali ke tempat perjalanan bermula.</p>
    <a class="button button--primary" href={`${base}`} data-transition>Kembali ke beranda <span aria-hidden="true">↗</span></a>
  </section>
  <section class="next-page section-shell" aria-label="Navigasi berikutnya">
    <div><p class="eyebrow">ATAU MULAI DARI SINI</p><h2 class="section-title">Peta <em>Realm.</em></h2></div>
    <a class="next-page__link" href={`${base}realms/`} data-transition><span>Jelajahi enam Realm</span><b aria-hidden="true">↗</b></a>
  </section>
</BaseLayout>

---
const { media, className = '', caption = '', eager = false, fit = 'cover', interactive = true, parallax = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const hasVideo = media.status === 'verified' && Boolean(media.youtubeId);
const posterPath = media.poster?.startsWith('http') ? media.poster : `${base}${media.poster || 'media/placeholder.svg'}`;
const hqFallback = media.youtubeId ? `https://i.ytimg.com/vi/${media.youtubeId}/hqdefault.jpg` : `${base}media/placeholder.svg`;
const watchUrl = hasVideo ? `https://www.youtube.com/watch?v=${media.youtubeId}` : '';
---

<figure
  class={`media-frame ${className}`}
  data-media-frame
  data-media-id={media.id}
  data-youtube-id={hasVideo && interactive ? media.youtubeId : ''}
  data-watch-url={hasVideo && interactive ? watchUrl : ''}
  data-fit={fit}
  data-parallax={parallax ? '' : undefined}
>
  <div class="media-frame__image">
    <img
      src={posterPath}
      data-fallback={hqFallback}
      data-hq-fallback={`${base}media/placeholder.svg`}
      alt={media.alt}
      width="1280"
      height="720"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <div class="media-frame__wash" aria-hidden="true"></div>
    {hasVideo ? (
      interactive ? (
        <a class="media-frame__play" href={watchUrl} data-load-youtube aria-label={`Putar video: ${caption || media.section}`}>
          <span class="play-mark" aria-hidden="true"></span>
          <span class="media-frame__play-label">Putar video</span>
        </a>
      ) : null
    ) : media.status === 'placeholder' ? (
      <span class="media-frame__placeholder-label">Visual menyusul</span>
    ) : null}
  </div>
  {caption && <figcaption class="media-frame__caption">{caption}</figcaption>}
</figure>
